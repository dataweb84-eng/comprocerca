SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Usar el Transaction Pooler de Supabase (compatible IPv4, pensado para
# serverless) en vez de la conexion directa db.PROJECT_REF.supabase.co,
# que por defecto es IPv6-only y falla en plataformas como Vercel.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
PORT=4000
SESSION_SECRET=
